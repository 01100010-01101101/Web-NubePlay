# URL base de la API del backend (Spring Boot). Copia este archivo como ".env" si cambia.
VITE_API_URL=http://localhost:8080/api/v1

# ID de cliente OAuth 2.0 de Google (Google Cloud Console → APIs y servicios → Credenciales).
# Si se deja vacío, el botón "Iniciar sesión con Google" no se muestra.
VITE_GOOGLE_CLIENT_ID=
